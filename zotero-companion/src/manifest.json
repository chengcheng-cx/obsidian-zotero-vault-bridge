{
  "manifest_version": 2,
  "name": "Zotero Vault Bridge Companion",
  "version": "0.1.0",
  "description": "Links PDFs from an allowed Obsidian vault and asks Zotero to recognize them.",
  "homepage_url": "https://github.com/chengcheng-cx/obsidian-zotero-vault-bridge",
  "applications": {
    "zotero": {
      "id": "zotero-vault-bridge@example.local",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
